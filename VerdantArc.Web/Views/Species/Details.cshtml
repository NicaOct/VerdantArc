@model VerdantArc.Application.DTOs.SpeciesResponseDto
@{
    ViewData["Title"] = Model.CommonName;
}

<div class="container">
    <div style="margin-bottom: 2rem;">
        <a href="/Species" style="color: var(--text-light); text-decoration: none;">&larr; Back to Catalog</a>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 3rem;">
        <div class="card glass" style="padding: 2rem;">
            <div style="text-align: center; margin-bottom: 2rem;">
                @{
                    var categoryIcon = Model.Category switch {
                        "Mammal" => "🐻",
                        "Bird" => "🦅",
                        "Reptile" => "🦎",
                        "Plant" => "🌿",
                        "Fish" => "🐟",
                        "Insect" => "🦋",
                        _ => "🌿"
                    };
                }
                <div style="width: 150px; height: 150px; border-radius: 50%; background: var(--secondary-color); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 4rem;">
                    @categoryIcon
                </div>
                <h3 style="margin-bottom: 0.5rem;">@Model.CommonName</h3>
                <p style="font-style: italic; color: var(--text-light);">@Model.ScientificName</p>
            </div>

            <ul style="list-style: none; padding: 0;">
                <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between;">
                    <span style="font-weight: 500;">Category</span>
                    <span>@Model.Category</span>
                </li>
                <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between;">
                    <span style="font-weight: 500;">Conservation Status</span>
                    <span style="font-weight: bold;">@Model.ConservationStatus</span>
                </li>
                <li style="padding: 0.5rem 0; display: flex; justify-content: space-between;">
                    <span style="font-weight: 500;">Endemic to Area</span>
                    <span>@(Model.IsEndemic ? "Yes" : "No")</span>
                </li>
            </ul>
        </div>

        <div>
            <h1 style="font-size: 3rem; color: var(--primary-color); margin-bottom: 1rem;">@Model.CommonName</h1>
            <p style="font-size: 1.1rem; line-height: 1.8; margin-bottom: 3rem;">@Model.Description</p>

            <h3 style="margin-bottom: 1.5rem;">Recent Sightings (iNaturalist)</h3>
            <div id="inaturalist-observations">
                <p style="color: var(--text-light);"><span class="loader"></span> Loading observations...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const container = document.getElementById('inaturalist-observations');
            const taxonName = encodeURIComponent('@Model.ScientificName');
            const placeId = 7085; // Romania

            try {
                const response = await fetch(`https://api.inaturalist.org/v1/observations?place_id=${placeId}&taxon_name=${taxonName}&order=desc&order_by=created_at&per_page=5`);
                const data = await response.json();

                if (data.results && data.results.length > 0) {
                    let html = '<div class="grid" style="grid-template-columns: 1fr;">';
                    data.results.forEach(obs => {
                        const imgUrl = obs.photos.length > 0 ? obs.photos[0].url : '';
                        const date = new Date(obs.time_observed_at).toLocaleDateString();
                        const user = obs.user.login;
                        const place = obs.place_guess || 'Unknown location';

                        html += `
                            <div class="card" style="display: flex; flex-direction: row; align-items: center; padding: 1rem; margin-bottom: 1rem;">
                                ${imgUrl ? `<img src="${imgUrl}" alt="Observation" style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-sm); margin-right: 1.5rem;" />` : '<div style="width: 80px; height: 80px; background: var(--secondary-color); border-radius: var(--radius-sm); margin-right: 1.5rem;"></div>'}
                                <div>
                                    <p style="font-weight: 600; margin-bottom: 0.2rem;">Observed by @@${user}</p>
                                    <p style="color: var(--text-light); font-size: 0.9rem; margin-bottom: 0;">📍 ${place}</p>
                                    <p style="color: var(--text-light); font-size: 0.9rem; margin-bottom: 0;">📅 ${date}</p>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p>No recent sightings found for this species in the area.</p>';
                }
            } catch (error) {
                console.error("Error fetching iNaturalist data:", error);
                container.innerHTML = '<p style="color: var(--danger-color);">Failed to load observations. Please try again later.</p>';
            }
        });
    </script>
}
