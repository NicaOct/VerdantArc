@model IEnumerable<VerdantArc.Application.DTOs.SpeciesResponseDto>
@{
    ViewData["Title"] = "Species Catalog";
}

<div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1 style="font-size: 2.5rem; color: var(--primary-color);">Wildlife & Flora</h1>
        <div>
            <form method="get" action="/Species/Index">
                <select name="category" class="form-control" style="width: auto; display: inline-block;" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    <option value="Mammal">Mammals</option>
                    <option value="Bird">Birds</option>
                    <option value="Reptile">Reptiles</option>
                    <option value="Plant">Plants</option>
                    <option value="Fish">Fish</option>
                    <option value="Insect">Insects</option>
                </select>
            </form>
        </div>
    </div>

    <div class="grid">
        @foreach (var s in Model)
        {
            <div class="card">
                <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="@s.CommonName" class="card-img inat-img" data-taxon="@s.ScientificName" style="background: var(--border-color); object-fit: cover;" />
                <div class="card-body">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                        <h3 class="card-title" style="margin: 0;">@s.CommonName</h3>
                        <span class="badge" style="background: var(--primary-color); color: white;">@s.Category</span>
                    </div>
                    <p style="font-style: italic; color: var(--text-light); margin-bottom: 1rem;">@s.ScientificName</p>
                    <p style="margin-bottom: 1rem; flex: 1;">@s.Description</p>
                    
                    <div style="margin-bottom: 1.5rem;">
                        <strong>Status:</strong> 
                        <span style="color: @(s.ConservationStatus == "LC" ? "var(--success-color)" : "var(--danger-color)"); font-weight: bold;">
                            @s.ConservationStatus
                        </span>
                    </div>
                    <a href="/Species/Details/@s.Id" class="btn btn-outline" style="width: 100%;">View Details</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const placeId = 7085; // Romania
            const images = document.querySelectorAll('.inat-img');
            
            images.forEach(async (img) => {
                const taxonName = encodeURIComponent(img.dataset.taxon);
                try {
                    const response = await fetch(`https://api.inaturalist.org/v1/observations?place_id=${placeId}&taxon_name=${taxonName}&order=desc&order_by=created_at&per_page=1&has[]=photos`);
                    const data = await response.json();
                    
                    if (data.results && data.results.length > 0 && data.results[0].photos.length > 0) {
                        // Use a higher quality image URL by replacing 'square' with 'medium'
                        const photoUrl = data.results[0].photos[0].url.replace('square', 'medium');
                        img.src = photoUrl;
                    }
                } catch (error) {
                    console.error("Error fetching image for " + taxonName, error);
                }
            });
        });
    </script>
}
