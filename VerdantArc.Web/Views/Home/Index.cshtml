@{
    ViewData["Title"] = "Home Page";
}

<div class="hero">
    <div class="animate-fade-in">
        <h1>Welcome to VerdantArc</h1>
        <p>Explore the beauty of nature, track wildlife, and enjoy breathtaking trails in our 2400-hectare protected reserve.</p>
        <a href="/Trails" class="btn btn-primary" style="font-size: 1.25rem; padding: 1rem 2rem;">Explore Trails</a>
    </div>
</div>

<div class="container" style="margin-top: -50px; position: relative; z-index: 10;">
    <div class="grid">
        <div class="card glass text-center" style="padding: 2rem;">
            <h2 style="font-size: 3rem; color: var(--primary-color);">3</h2>
            <p style="font-weight: 600; font-size: 1.25rem;">Active Trails</p>
        </div>
        <div class="card glass text-center" style="padding: 2rem;">
            <h2 style="font-size: 3rem; color: var(--primary-color);">10+</h2>
            <p style="font-weight: 600; font-size: 1.25rem;">Protected Species</p>
        </div>
        <div class="card glass text-center" style="padding: 2rem;">
            <h2 style="font-size: 3rem; color: var(--primary-color);">2400</h2>
            <p style="font-weight: 600; font-size: 1.25rem;">Hectares</p>
        </div>
    </div>
</div>

<div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: 3rem;">What You Can Do</h2>
    <div class="grid">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Hike Beautiful Trails</h3>
                <p>From easy walks around the lake to challenging mountain peaks, find the perfect trail for your skill level.</p>
                <a href="/Trails" class="btn btn-outline" style="margin-top: 1rem;">View Trails</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Discover Wildlife</h3>
                <p>Learn about our endemic and protected species. Use our integration with iNaturalist to report your sightings.</p>
                <a href="/Species" class="btn btn-outline" style="margin-top: 1rem;">View Catalog</a>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Check Live Weather</h3>
                <p>Before you plan your trip, check the live weather conditions and 7-day forecast directly on our platform.</p>
                <a href="/Weather" class="btn btn-outline" style="margin-top: 1rem;">Check Weather</a>
            </div>
        </div>
    </div>
</div>
