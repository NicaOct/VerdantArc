@model IEnumerable<VerdantArc.Application.DTOs.SpeciesResponseDto>
@{
    ViewData["Title"] = "Manage Species";
}

<div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <a href="/Admin/Dashboard" style="font-size: 0.9rem; text-decoration: none; color: var(--secondary-color); font-weight: 600;">&larr; Back to Dashboard</a>
            <h1 style="font-size: 2.5rem; color: var(--primary-color); margin-top: 0.5rem;">Manage Species</h1>
        </div>
        <a href="/Admin/Species/Create" class="btn btn-primary">Add New Species</a>
    </div>

    <div class="card glass" style="padding: 1.5rem; border-radius: var(--radius-lg); overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-light); font-weight: 600;">
                    <th style="padding: 1rem 0.5rem;">Common Name</th>
                    <th style="padding: 1rem 0.5rem;">Scientific Name</th>
                    <th style="padding: 1rem 0.5rem;">Category</th>
                    <th style="padding: 1rem 0.5rem;">Conservation Status</th>
                    <th style="padding: 1rem 0.5rem;">Endemic</th>
                    <th style="padding: 1rem 0.5rem; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr style="border-bottom: 1px solid var(--border-color); transition: var(--transition);">
                        <td style="padding: 1rem 0.5rem; font-weight: 600; color: var(--primary-color);">@s.CommonName</td>
                        <td style="padding: 1rem 0.5rem; font-style: italic;">@s.ScientificName</td>
                        <td style="padding: 1rem 0.5rem;">@s.Category</td>
                        <td style="padding: 1rem 0.5rem;">
                            <span style="padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
                                @(s.ConservationStatus == "LC" ? "background:#E8F5E9;color:#2E7D32;" : 
                                  s.ConservationStatus == "NT" ? "background:#E3F2FD;color:#1565C0;" : 
                                  s.ConservationStatus == "VU" ? "background:#FFF3E0;color:#EF6C00;" : 
                                  "background:#FFEBEE;color:#C62828;")">
                                @s.ConservationStatus
                            </span>
                        </td>
                        <td style="padding: 1rem 0.5rem;">@(s.IsEndemic ? "Yes 🌸" : "No")</td>
                        <td style="padding: 1rem 0.5rem; text-align: right;">
                            <div style="display: inline-flex; gap: 0.5rem; justify-content: flex-end;">
                                <a href="/Admin/Species/Edit/@s.Id" class="btn btn-outline" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Edit</a>
                                <form method="post" action="/Admin/Species/Delete/@s.Id" onsubmit="return confirm('Are you sure you want to delete this species?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background-color: var(--danger-color); color: white; border: none; border-radius: var(--radius-sm); cursor: pointer;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
