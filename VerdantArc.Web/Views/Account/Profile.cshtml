@model VerdantArc.Domain.Entities.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="container">
    <div class="card glass" style="max-width: 800px; margin: 0 auto; padding: 3rem;">
        <div style="display: flex; align-items: center; gap: 2rem; margin-bottom: 3rem; border-bottom: 1px solid var(--border-color); padding-bottom: 2rem;">
            <div style="width: 100px; height: 100px; background: var(--primary-color); border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: bold;">
                @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "?")
            </div>
            <div>
                <h1 style="margin-bottom: 0.5rem;">@Model.FullName</h1>
                <p style="color: var(--text-light); margin-bottom: 0;">@Model.Email</p>
                <p style="color: var(--text-light); font-size: 0.9rem;">Member since @Model.RegisteredAt.ToString("MMM yyyy")</p>
            </div>
        </div>

        <h3>My Contributions</h3>
        <p>You haven't submitted any trail reports or sightings yet. Explore the trails and share your experiences!</p>
    </div>
</div>
